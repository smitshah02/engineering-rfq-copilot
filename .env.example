# Safe illustrative placeholders only. Never copy real passwords into this example.
# Percent-encode special characters in the username/password portions of each URL.
# Process variables override an explicitly selected dotenv file.
DATABASE_URL='postgresql+asyncpg://example_role:replace_me@127.0.0.1:5432/example_dev'
TEST_DATABASE_URL='postgresql+asyncpg://example_role:replace_me@127.0.0.1:5432/example_test'
# Test connections must match this explicit name and differ from DATABASE_URL's database.
TEST_DATABASE_NAME='example_test'
