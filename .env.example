# Local development reference: placeholders and non-secret defaults only.
# Replace role/password, key-path and model placeholders privately; provision nothing here.
# Percent-encode special characters in URL usernames/passwords.
# Do not source/export this entire file into services or browser tooling.
# Process variables override an explicitly selected dotenv file.
# scripts/dev_env.sh filters this file for DEVELOPMENT service startup; see
# docs/development/background_processing.md for prerequisites and process boundaries.

# Non-secret target metadata. These names match the guarded local migration/seed targets.
# Every selected URL must match this host, port and its development/test database.
DEVELOPMENT_DATABASE_NAME=rfq_copilot_dev
TEST_DATABASE_NAME=rfq_copilot_test
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# Administrative owners: reviewed migrations, seeding, integrity, provisioning and tests.
# Keep these out of API, MCP, worker and drafter process environments.
DATABASE_URL='postgresql+asyncpg://example_owner_role:replace_me@127.0.0.1:5432/rfq_copilot_dev'
TEST_DATABASE_URL='postgresql+asyncpg://example_owner_test_role:replace_me@127.0.0.1:5432/rfq_copilot_test'

# Ordinary API and MCP: restricted application role, never the owner.
# Reviewed provisioning reference: docs/database/k2_runtime_roles.sql.
APP_DATABASE_URL='postgresql+asyncpg://example_app_role:replace_me@127.0.0.1:5432/rfq_copilot_dev'
TEST_APP_DATABASE_URL='postgresql+asyncpg://example_app_test_role:replace_me@127.0.0.1:5432/rfq_copilot_test'

# Human-decision process only: separate role with rfq_quote_decision membership.
# Never supply this URL to the ordinary API, MCP or agent context.
# Reviewed provisioning reference: docs/database/k5_decision_roles.sql.
DECISION_DATABASE_URL='postgresql+asyncpg://example_decision_role:replace_me@127.0.0.1:5432/rfq_copilot_dev'
TEST_DECISION_DATABASE_URL='postgresql+asyncpg://example_decision_test_role:replace_me@127.0.0.1:5432/rfq_copilot_test'

# Separate workflow worker and quotation-drafter credentials.
# References: docs/database/a1_workflow_role.sql and docs/database/a4_drafter_role.sql.
# Role names are illustrative; actual live grants are checked before restricted sessions.
WORKFLOW_DATABASE_URL='postgresql+asyncpg://example_workflow_role:replace_me@127.0.0.1:5432/rfq_copilot_dev'
TEST_WORKFLOW_DATABASE_URL='postgresql+asyncpg://example_workflow_test_role:replace_me@127.0.0.1:5432/rfq_copilot_test'
DRAFTER_DATABASE_URL='postgresql+asyncpg://example_drafter_role:replace_me@127.0.0.1:5432/rfq_copilot_dev'
TEST_DRAFTER_DATABASE_URL='postgresql+asyncpg://example_drafter_test_role:replace_me@127.0.0.1:5432/rfq_copilot_test'

# Ordinary and decision API JWT verification. Non-secret local trust identifiers must
# match the provisioned issuer/tokens; this issuer URL does not provide a login endpoint.
# Use an EXISTING public key. The API never needs the matching private signing key.
# Alternatively configure RFQ_API_JWT_PUBLIC_KEYS instead of the single-file setting.
RFQ_API_ENVIRONMENT=development
RFQ_API_JWT_ISSUER=http://127.0.0.1:8765
RFQ_API_JWT_AUDIENCE=rfq-copilot-portal
RFQ_API_JWT_ALGORITHM=EdDSA
RFQ_API_JWT_PUBLIC_KEY_FILE=/absolute/path/to/existing/dev_jwt_ed25519.pub.pem
RFQ_API_JWT_MAX_LIFETIME_SECONDS=900
# Current customer workflow: active schema, registered RBAC v4 overlay, provisioned
# identities/bindings and recorded workflow-queue activation are prerequisites.
# API policy v3 accepts customer permissions; MCP independently uses policy v2.
RFQ_API_PERMISSION_POLICY=v3
RFQ_API_TOKEN_REVOCATION=enforced
RFQ_API_UPLOAD_IDEMPOTENCY=enabled
RFQ_API_RFQ_ASSIGNMENTS=off
RFQ_API_CUSTOMER_CONTEXT=single
RFQ_API_WORKFLOW_QUEUE=enabled
# Set assignments to required only with corresponding staff/service assignments provisioned.
# Upload storage must be an absolute private path with trusted ancestors (directory 0700).
RFQ_API_ATTACHMENT_DIR=/absolute/path/to/private/rfq_uploads
RFQ_API_MAX_UPLOAD_BYTES=10485760

# MCP host: restricted APP_DATABASE_URL plus non-secret loopback ingress settings.
RFQ_MCP_DATABASE_TARGET=development
RFQ_MCP_RESOURCE_SERVER_URL=http://127.0.0.1:8765/mcp/manufacturing
RFQ_MCP_HOST_PUBLIC_BASE_URL=http://127.0.0.1:8765
RFQ_MCP_HOST_ALLOWED_HOSTS=127.0.0.1:8765,localhost:8765
# MCP and worker trust: match the existing signing key/issuer; keep audiences distinct.
RFQ_MCP_JWT_ISSUER=http://127.0.0.1:8765
RFQ_MCP_JWT_AUDIENCE=rfq-copilot-mcp
RFQ_MCP_JWT_ALGORITHM=EdDSA
RFQ_MCP_JWT_PUBLIC_KEY_FILE=/absolute/path/to/existing/dev_jwt_ed25519.pub.pem
RFQ_MCP_PERMISSION_POLICY=v2
RFQ_MCP_TOKEN_REVOCATION=enforced
RFQ_MCP_RFQ_ASSIGNMENTS=off

# Worker-only model and delegated MCP credentials. Select an already installed local model.
# The existing development provider signs short-lived MCP service tokens with this key.
# Keep its private key outside the repository, owned by the process user, mode 0600.
RFQ_WORKFLOW_ENVIRONMENT=development
RFQ_WORKFLOW_LLM=ollama
RFQ_WORKFLOW_OLLAMA_MODEL=REPLACE_WITH_INSTALLED_MODEL
RFQ_WORKFLOW_OLLAMA_BASE_URL=http://127.0.0.1:11434
RFQ_WORKFLOW_MCP_BASE_URL=http://127.0.0.1:8765
RFQ_WORKFLOW_MCP_SIGNING_KEY_FILE=/absolute/path/to/existing/dev_jwt_ed25519.pem

# Consumer bounds: concurrency 1..4; poll 1..60 s; backoff poll..300 s; grace 0..300 s.
# CLI timing flags override environment values. Non-finite values fail startup.
RFQ_WORKFLOW_CONCURRENCY=1
RFQ_WORKFLOW_POLL_SECONDS=5
RFQ_WORKFLOW_ERROR_BACKOFF_MAX_SECONDS=60
RFQ_WORKFLOW_SHUTDOWN_GRACE_SECONDS=30
RFQ_DRAFTER_CONCURRENCY=1
RFQ_DRAFTER_POLL_SECONDS=5
RFQ_DRAFTER_ERROR_BACKOFF_MAX_SECONDS=60
RFQ_DRAFTER_SHUTDOWN_GRACE_SECONDS=30
# The drafter needs no model, MCP trust configuration, signing key or decision URL.

# Optional Supervisor telemetry, for a caller that explicitly supplies a telemetry sink.
# The development launcher does not forward these variables. Keys alone enable nothing.
# Match the endpoint to your project region or self-hosted installation.
RFQ_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=REPLACE_WITH_YOUR_LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=REPLACE_WITH_YOUR_LANGFUSE_SECRET_KEY
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_TRACING_ENVIRONMENT=development
