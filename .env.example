# Safe illustrative placeholders only. Never copy real passwords into this example.
# Percent-encode special characters in the username/password portions of each URL.
# Process variables override an explicitly selected dotenv file.
DATABASE_URL='postgresql+asyncpg://example_role:replace_me@127.0.0.1:5432/example_dev'
TEST_DATABASE_URL='postgresql+asyncpg://example_role:replace_me@127.0.0.1:5432/example_test'
# Test connections must match this explicit name and differ from DATABASE_URL's database.
TEST_DATABASE_NAME='example_test'
# K2 restricted runtime roles (docs/database/k2_runtime_roles.sql): same database as the
# owner URL above, a different role that owns nothing. Never reuse the owner credentials.
APP_DATABASE_URL='postgresql+asyncpg://example_app_role:replace_me@127.0.0.1:5432/example_dev'
TEST_APP_DATABASE_URL='postgresql+asyncpg://example_app_test_role:replace_me@127.0.0.1:5432/example_test'
# K5 decision roles (docs/database/k5_decision_roles.sql): members of rfq_quote_decision,
# distinct from the owner and app roles. Only the human decision process
# (rfq_copilot.api.decision_app) reads these; never give them to agents, MCP or the main API.
DECISION_DATABASE_URL='postgresql+asyncpg://example_decision_role:replace_me@127.0.0.1:5432/example_dev'
TEST_DECISION_DATABASE_URL='postgresql+asyncpg://example_decision_test_role:replace_me@127.0.0.1:5432/example_test'

# Optional Langfuse telemetry. Disabled unless RFQ_LANGFUSE_ENABLED=true; keys alone
# enable nothing. Set LANGFUSE_BASE_URL to your project's region or self-hosted URL.
RFQ_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=REPLACE_WITH_YOUR_LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=REPLACE_WITH_YOUR_LANGFUSE_SECRET_KEY
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_TRACING_ENVIRONMENT=development
