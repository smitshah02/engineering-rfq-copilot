{
  "version": "rbac-policy-v4",
  "builds_on": "rbac-policy-v3",
  "roles": ["identity_operator", "customer", "rfq_workflow_agent"],
  "permissions": [
    "view_catalog",
    "view_quote",
    "attach_rfq_document",
    "manage_customer_bindings",
    "revoke_tokens",
    "customer_view_rfq",
    "customer_create_rfq",
    "customer_view_quote",
    "customer_attach_rfq_document"
  ],
  "grants": [
    ["sales_representative", "view_catalog"],
    ["estimator", "view_catalog"],
    ["manufacturing_engineer", "view_catalog"],
    ["estimator", "view_quote"],
    ["sales_representative", "view_quote"],
    ["sales_manager", "view_quote"],
    ["auditor", "view_quote"],
    ["sales_representative", "attach_rfq_document"],
    ["estimator", "attach_rfq_document"],
    ["identity_operator", "manage_customer_bindings"],
    ["identity_operator", "revoke_tokens"],
    ["customer", "view_customer"],
    ["customer", "customer_view_rfq"],
    ["customer", "customer_create_rfq"],
    ["customer", "customer_view_quote"],
    ["customer", "customer_attach_rfq_document"],
    ["rfq_workflow_agent", "view_catalog"],
    ["rfq_workflow_agent", "view_assigned_rfqs"],
    ["rfq_workflow_agent", "view_quote"],
    ["rfq_workflow_agent", "create_quote_draft"]
  ]
}
